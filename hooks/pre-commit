#!/bin/bash
# ============================================================
# pre-commit - Prevent committing secrets
# ============================================================

# Colors
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Patterns that indicate secrets
PATTERNS=(
  "sk-or-v1-[a-f0-9]{64}"          # OpenRouter keys
  "sk-[a-zA-Z0-9]{48}"             # Generic API keys
  "AKIA[0-9A-Z]{16}"               # AWS keys
  "[a-zA-Z0-9_-]{32,}"             # Long tokens (be careful with this)
)

# Check staged files for secret patterns
for pattern in "${PATTERNS[@]}"; do
  if git diff --cached --diff-filter=AM | grep -E "$pattern" >/dev/null 2>&1; then
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${RED}  ERROR: Potential secret detected in commit!${NC}"
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo -e "Pattern matched: ${YELLOW}$pattern${NC}"
    echo ""
    echo "Please remove the secret before committing."
    echo "If this is a false positive, use: git commit --no-verify"
    echo ""
    exit 1
  fi
done

# Check for specific filenames that shouldn't be committed
FORBIDDEN_FILES=(
  ".zshrc.secrets"
  "id_rsa"
  "id_ed25519"
  "*.pem"
  "*.key"
)

for file_pattern in "${FORBIDDEN_FILES[@]}"; do
  if git diff --cached --name-only | grep -E "$file_pattern" >/dev/null 2>&1; then
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${RED}  ERROR: Forbidden file in commit!${NC}"
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo -e "File: ${YELLOW}$file_pattern${NC}"
    echo ""
    echo "This file should not be committed to the repository."
    echo "If this is intentional, use: git commit --no-verify"
    echo ""
    exit 1
  fi
done

exit 0
