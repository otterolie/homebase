# ============================================================
# zshrc - OPTIMIZED POWER USER VERSION
# Homebase: https://github.com/otterolie/homebase
# ============================================================

# Source secrets if available (API keys, tokens, etc.)
[[ -f ~/.zshrc.secrets ]] && source ~/.zshrc.secrets

export ZSH="$HOME/.oh-my-zsh"

# Core plugins only (syntax-highlighting loaded async below)
plugins=(git vi-mode)

source $ZSH/oh-my-zsh.sh

# ── PATH ─────────────────────────────────────────────────────
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/go/bin:$PATH"
export PATH="$HOME/.bun/bin:$PATH"
export PATH="$HOME/.npm-global/bin:$PATH"
export PATH="/usr/local/bin:$PATH"

# pnpm - Platform-aware
if [[ "$OSTYPE" == "darwin"* ]]; then
  export PNPM_HOME="/Users/$USER/Library/pnpm"
else
  export PNPM_HOME="$HOME/.local/share/pnpm"
fi
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# ── Lazy-load nvm (300ms → 0ms on startup) ──────────────────
export NVM_DIR="$HOME/.nvm"

nvm() {
  unset -f nvm node npm npx
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
  [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
  nvm "$@"
}

node() {
  unset -f nvm node npm npx
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
  node "$@"
}

npm() {
  unset -f nvm node npm npx
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
  npm "$@"
}

npx() {
  unset -f nvm node npm npx
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
  npx "$@"
}

# bun
export BUN_INSTALL="$HOME/.bun"
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# ── Environment ──────────────────────────────────────────────
# Editor (for git, etc.)
export EDITOR="nvim"
export VISUAL="nvim"

# Better history
export HISTSIZE=100000
export SAVEHIST=100000
export HISTFILE=~/.zsh_history
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt SHARE_HISTORY

# ── Critical tools (load immediately) ────────────────────────
eval "$(starship init zsh)"
eval "$(zoxide init zsh)"

# ── Deferred initialization (load in background) ─────────────
{
  # These load async to not block shell startup
  command -v fzf >/dev/null && eval "$(fzf --zsh)"
  command -v direnv >/dev/null && eval "$(direnv hook zsh)"
} &!

# ── Load plugins asynchronously ──────────────────────────────
{
  [[ -f "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] && \
    source "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

  [[ -f "$ZSH_CUSTOM/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] && \
    source "$ZSH_CUSTOM/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
} &!

# ── Aliases ──────────────────────────────────────────────────

# Modern replacements
alias ls="eza --icons"
alias ll="eza -la --icons --git"
alias la="eza -la --icons --git"
alias lt="eza --tree --level=2 --icons"
alias cat="bat --paging=never"
alias catp="bat"  # with paging
alias grep="rg"
alias find="fd"

# Directory navigation
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias ~="cd ~"
alias -- -="cd -"

# Better defaults
alias df="df -h"
alias mkdir="mkdir -p"

# Quick edits
alias zshrc="$EDITOR ~/.zshrc"
alias hosts="sudo $EDITOR /etc/hosts"

# Claude Code
alias cc='claude'
alias ccg='claude-glm'
alias ccg45='claude-glm-4.5'
alias ccf='claude-glm-fast'
alias ccd='claude-ds'

# Git / Lazygit
alias lg='lazygit'
alias g='git'
alias gs='git status'
alias ga='git add'
alias gaa='git add --all'
alias gd='git diff'
alias gds='git diff --staged'
alias gc='git commit -v'
alias gca='git commit -v --amend'
alias gcm='git commit -m'
alias gp='git push'
alias gpf='git push --force-with-lease'
alias gl='git pull'
alias gb='git branch'
alias gco='git checkout'
alias gcb='git checkout -b'
alias glo='git log --oneline --graph --decorate'
alias glol='git log --graph --pretty="%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%ar) %C(bold blue)<%an>%Creset"'
alias gst='git stash'
alias gstp='git stash pop'
alias grb='git rebase'
alias grbi='git rebase -i'

# pnpm shortcuts
alias pi='pnpm install'
alias pa='pnpm add'
alias pad='pnpm add -D'
alias pr='pnpm run'
alias pd='pnpm dev'
alias pb='pnpm build'
alias pt='pnpm test'

# Docker
alias d='docker'
alias dc='docker compose'
alias dcu='docker compose up'
alias dcd='docker compose down'
alias dcl='docker compose logs -f'
alias dps='docker ps'
alias dpsa='docker ps -a'

# Network
alias ip="curl -s https://api.ipify.org && echo"
alias ports="lsof -PiTCP -sTCP:LISTEN"

# System
alias cpu="top -o cpu"
alias mem="top -o mem"
alias top="btop"
alias du="dust"

# ── Functions ────────────────────────────────────────────────

# Quick directory jump with fzf
fcd() {
  local dir
  dir=$(fd --type d --hidden --exclude .git | fzf --preview 'eza --tree --level=1 --icons {}') && cd "$dir"
}

# Quick file edit with fzf
fe() {
  local file
  file=$(fd --type f --hidden --exclude .git | fzf --preview 'bat --color=always {}') && $EDITOR "$file"
}

# Git branch switcher with fzf
fbr() {
  local branches branch
  branches=$(git branch -a) &&
  branch=$(echo "$branches" | fzf +m) &&
  git checkout $(echo "$branch" | sed "s/.* //" | sed "s#remotes/[^/]*/##")
}

# Kill process with fzf
fkill() {
  local pid
  pid=$(ps -ef | sed 1d | fzf -m | awk '{print $2}')
  if [ "x$pid" != "x" ]; then
    echo $pid | xargs kill -${1:-9}
  fi
}

# Create directory and cd into it
mkcd() {
  mkdir -p "$1" && cd "$1"
}

# Extract any archive
extract() {
  if [ -f $1 ]; then
    case $1 in
      *.tar.bz2)   tar xjf $1     ;;
      *.tar.gz)    tar xzf $1     ;;
      *.bz2)       bunzip2 $1     ;;
      *.rar)       unrar e $1     ;;
      *.gz)        gunzip $1      ;;
      *.tar)       tar xf $1      ;;
      *.tbz2)      tar xjf $1     ;;
      *.tgz)       tar xzf $1     ;;
      *.zip)       unzip $1       ;;
      *.Z)         uncompress $1  ;;
      *.7z)        7z x $1        ;;
      *)           echo "'$1' cannot be extracted" ;;
    esac
  else
    echo "'$1' is not a valid file"
  fi
}

# Quick server (current directory)
serve() {
  local port="${1:-8000}"
  python3 -m http.server "$port"
}

# Find file and open in editor
ef() {
  $EDITOR $(fzf)
}

# Preview files with bat
fp() {
  fzf --preview 'bat --color=always {}'
}

# ── FZF Configuration ────────────────────────────────────────
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'

# Catppuccin Mocha theme for fzf
export FZF_DEFAULT_OPTS=" \
--color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8 \
--color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc \
--color=marker:#f5e0dc,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8"

# Preview with bat
export FZF_CTRL_T_OPTS="--preview 'bat --color=always --line-range :500 {}'"
export FZF_ALT_C_OPTS="--preview 'eza --tree --level=1 {}'"

# ── Vim mode enhancements ────────────────────────────────────
# Better key timeout (faster ESC in vim mode)
export KEYTIMEOUT=1

# ── Rust/Cargo ───────────────────────────────────────────────
[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

# ── Platform-specific ────────────────────────────────────────
if [[ "$OSTYPE" == "darwin"* ]]; then
  # macOS specific
  alias showfiles="defaults write com.apple.finder AppleShowAllFiles -bool true && killall Finder"
  alias hidefiles="defaults write com.apple.finder AppleShowAllFiles -bool false && killall Finder"
  alias cleanup="find . -type f -name '*.DS_Store' -ls -delete"
  alias localip="ipconfig getifaddr en0"

  # Load SSH keys from keychain
  ssh-add --apple-load-keychain 2>/dev/null
fi
